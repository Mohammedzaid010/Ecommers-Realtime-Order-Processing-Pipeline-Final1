<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
  xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
  xmlns="http://www.mulesoft.org/schema/mule/core"
  xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
  http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
  http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
  <munit:config name="sapi-coverage-suite.xml"/>

  <munit:test name="sapi-get-order-success" description="Existing order is returned with its items">
    <munit:behavior>
      <munit-tools:mock-when processor="db:select">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Select header"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[[{order_id: 'ORD-2026-1001', order_status: 'PERSISTED'}]]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="db:select">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Select items"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[[{product_id: 'PROD-101', quantity: 2}]]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit:set-event>
        <munit:attributes value="#[{uriParams: {orderId: 'ORD-2026-1001'}}]"/>
      </munit:set-event>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="get:\orders\(orderId):order-db-sapi-config"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.order_status]" is="#[MunitTools::equalTo('PERSISTED')]"/>
      <munit-tools:assert-that expression="#[sizeOf(payload.items)]" is="#[MunitTools::equalTo(1)]"/>
    </munit:validation>
  </munit:test>

  <munit:test name="sapi-insert-database-down-returns-503" description="DB unreachable: 503 DATABASE_UNAVAILABLE">
    <munit:behavior>
      <munit-tools:mock-when processor="db:insert">
        <munit-tools:then-return>
          <munit-tools:error typeId="DB:CONNECTIVITY"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <set-payload value="#[readUrl('classpath://test-data/canonical-order.json', 'application/json')]"/>
    </munit:behavior>
    <munit:execution>
      <try>
        <flow-ref name="post:\orders:application\json:order-db-sapi-config"/>
        <error-handler>
          <on-error-continue/>
        </error-handler>
      </try>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo('503')]"/>
      <munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('DATABASE_UNAVAILABLE')]"/>
    </munit:validation>
  </munit:test>

