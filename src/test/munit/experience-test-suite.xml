<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
  xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
  xmlns="http://www.mulesoft.org/schema/mule/core"
  xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
  http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
  http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
  <munit:config name="experience-test-suite.xml"/>

  <munit:test name="accept-order-success-returns-received" description="Valid order: stored, handed to Process API, 202 RECEIVED">
    <munit:behavior>
      <munit-tools:mock-when processor="os:store"/>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:then-return>
          <munit-tools:payload value="#[{status: 'RECEIVED'}]"/>
          <munit-tools:attributes value="#[{statusCode: 202}]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <set-payload value="#[readUrl('classpath://test-data/order-valid.json', 'application/json')]"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="accept-order-private-flow"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('RECEIVED')]"/>
      <munit-tools:assert-that expression="#[payload.orderId]" is="#[MunitTools::equalTo('ORD-2026-1001')]"/>
      <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo('202')]"/>
      <munit-tools:verify-call processor="http:request" times="1"/>
    </munit:validation>
  </munit:test>

  <munit:test name="accept-order-duplicate-raises-order-duplicate" description="Second submission is rejected, Process API never called" expectedErrorType="ORDER:DUPLICATE">
    <munit:behavior>
      <munit-tools:mock-when processor="os:store">
        <munit-tools:then-return>
          <munit-tools:error typeId="OS:KEY_ALREADY_EXISTS"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="http:request"/>
      <set-payload value="#[readUrl('classpath://test-data/order-valid.json', 'application/json')]"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="accept-order-private-flow"/>
    </munit:execution>
  </munit:test>

  <munit:test name="accept-order-process-api-down-releases-key" description="Process API unreachable: 503 error and idempotency key released">
    <munit:behavior>
      <munit-tools:mock-when processor="os:store"/>
      <munit-tools:mock-when processor="os:remove"/>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:then-return>
          <munit-tools:error typeId="HTTP:CONNECTIVITY"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <set-payload value="#[readUrl('classpath://test-data/order-valid.json', 'application/json')]"/>
    </munit:behavior>
    <munit:execution>
      <try>
        <flow-ref name="accept-order-private-flow"/>
        <error-handler>
          <on-error-continue type="ORDER:QUEUE_UNAVAILABLE"/>
        </error-handler>
      </try>
    </munit:execution>
    <munit:validation>
      <munit-tools:verify-call processor="os:remove" times="1"/>
    </munit:validation>
  </munit:test>

  <munit:test name="coverage-api-post-orders-accepts" description="APIKit implementation flow for POST /orders returns 202">
    <munit:behavior>
      <munit-tools:mock-when processor="os:store"/>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:then-return>
          <munit-tools:payload value="#[{status: 'RECEIVED'}]"/>
          <munit-tools:attributes value="#[{statusCode: 202}]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <set-payload value="#[readUrl('classpath://test-data/order-valid.json', 'application/json')]"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="post:\orders:application\json:order-experience-api-config"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('RECEIVED')]"/>
    </munit:validation>
  </munit:test>

