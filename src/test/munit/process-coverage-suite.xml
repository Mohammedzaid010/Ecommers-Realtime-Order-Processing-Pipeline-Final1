<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
  xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
  xmlns="http://www.mulesoft.org/schema/mule/core"
  xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
  http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
  http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
  <munit:config name="process-coverage-suite.xml"/>

  <flow name="coverage-publish-stub-flow">
    <set-variable variableName="publishLog" value="#[output application/java --- (vars.publishLog default []) ++ [vars.targetQueue]]"/>
  </flow>

  <flow name="coverage-publish-failing-stub-flow">
    <raise-error type="TEST:PUBLISH_FAILED" description="Simulated queue failure"/>
  </flow>

  <munit:test name="enqueue-order-success-returns-202" description="Order wrapped in an envelope, published to orders-queue, 202 RECEIVED">
    <munit:behavior>
      <set-variable variableName="queuePublishFlow" value="coverage-publish-stub-flow"/>
      <choice><when expression="#[false]"><flow-ref name="coverage-publish-stub-flow"/></when></choice>
      <set-payload value="#[readUrl('classpath://test-data/order-valid.json', 'application/json')]"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="enqueue-order-private-flow"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('RECEIVED')]"/>
      <munit-tools:assert-that expression="#[payload.orderId]" is="#[MunitTools::equalTo('ORD-2026-1001')]"/>
      <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo('202')]"/>
      <munit-tools:assert-that expression="#[vars.publishLog[0]]" is="#[MunitTools::equalTo('orders-queue')]"/>
    </munit:validation>
  </munit:test>

  <munit:test name="enqueue-order-publish-failure-raises-503" description="Queue failure surfaces as ORDER:QUEUE_UNAVAILABLE" expectedErrorType="ORDER:QUEUE_UNAVAILABLE">
    <munit:behavior>
      <set-variable variableName="queuePublishFlow" value="coverage-publish-failing-stub-flow"/>
      <choice><when expression="#[false]"><flow-ref name="coverage-publish-failing-stub-flow"/></when></choice>
      <set-payload value="#[readUrl('classpath://test-data/order-valid.json', 'application/json')]"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="enqueue-order-private-flow"/>
    </munit:execution>
  </munit:test>

  <munit:test name="coverage-api-post-orders-accepts" description="APIKit implementation flow for POST /orders returns 202">
    <munit:behavior>
      <set-variable variableName="queuePublishFlow" value="coverage-publish-stub-flow"/>
      <choice><when expression="#[false]"><flow-ref name="coverage-publish-stub-flow"/></when></choice>
      <set-payload value="#[readUrl('classpath://test-data/order-valid.json', 'application/json')]"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="post:\orders:application\json:order-process-api-config"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('RECEIVED')]"/>
    </munit:validation>
  </munit:test>

  <munit:test name="coverage-api-get-dlq-delegates" description="APIKit implementation flow for GET /admin/dlq returns the dead-letter view">
    <munit:behavior>
      <munit-tools:mock-when processor="os:retrieve-all">
        <munit-tools:then-return>
          <munit-tools:payload value="#[{}]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="get:\admin\dlq:order-process-api-config"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.depth]" is="#[MunitTools::equalTo(0)]"/>
    </munit:validation>
  </munit:test>

  <munit:test name="coverage-dlq-view-parses-messages" description="Stored dead letters come back as real JSON objects">
    <munit:behavior>
      <munit-tools:mock-when processor="os:retrieve-all">
        <munit-tools:then-return>
          <munit-tools:payload value="#[{a: '{&quot;reason&quot;:&quot;AMOUNT_MISMATCH&quot;,&quot;orderId&quot;:&quot;ORD-1&quot;,&quot;originalMessage&quot;:&quot;{\&quot;x\&quot;:1}&quot;}'}]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="dlq-view-private-flow"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.depth]" is="#[MunitTools::equalTo(1)]"/>
      <munit-tools:assert-that expression="#[payload.messages[0].reason]" is="#[MunitTools::equalTo('AMOUNT_MISMATCH')]"/>
    </munit:validation>
  </munit:test>

  <munit:test name="coverage-error-not-found-404" description="Router raises APIKIT:NOT_FOUND: structured error, HTTP 404">
    <munit:behavior>
      <munit-tools:mock-when processor="apikit:router">
        <munit-tools:then-return>
          <munit-tools:error typeId="APIKIT:NOT_FOUND"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <try>
        <flow-ref name="order-process-api-main"/>
        <error-handler>
          <on-error-continue/>
        </error-handler>
      </try>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo('404')]"/>
      <munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('NOT_FOUND')]"/>
    </munit:validation>
  </munit:test>

