  <munit:test name="coverage-notify-support-email-failure-is-contained" description="Support email failing does not break the flow">
    <munit:behavior>
      <munit-tools:mock-when processor="email:send">
        <munit-tools:then-return>
          <munit-tools:error typeId="EMAIL:CONNECTIVITY"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <set-variable variableName="orderId" value="ORD-1"/>
      <set-variable variableName="correlationId" value="corr-1"/>
      <set-variable variableName="errorDetail" value="detail"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="notify-support-subflow"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:verify-call processor="email:send" times="1"/>
    </munit:validation>
  </munit:test>

  <munit:test name="coverage-dlq-monitor-stores-dead-letter" description="A dead letter is stored for inspection">
    <munit:behavior>
      <munit-tools:mock-when processor="os:store"/>
      <set-payload value="#['{&quot;reason&quot;:&quot;INVALID_MESSAGE&quot;}']"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="dlq-monitor-processing-private-flow"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:verify-call processor="os:store" times="1"/>
    </munit:validation>
  </munit:test>

  <munit:test name="coverage-dlq-alert-below-threshold-sends-nothing" description="Few dead letters: no alert email">
    <munit:behavior>
      <munit-tools:mock-when processor="os:retrieve-all">
        <munit-tools:then-return>
          <munit-tools:payload value="#[{a: 'one'}]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="email:send"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="dlq-alert-flow"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:verify-call processor="email:send" times="0"/>
    </munit:validation>
  </munit:test>

  <munit:test name="coverage-dlq-alert-above-threshold-sends-email" description="Many dead letters: alert email sent">
    <munit:behavior>
      <munit-tools:mock-when processor="os:retrieve-all">
        <munit-tools:then-return>
          <munit-tools:payload value="#[{a: 1, b: 2, c: 3, d: 4, e: 5, f: 6}]"/>
        </munit-tools:then-return>
