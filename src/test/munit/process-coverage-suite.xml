  <munit:test name="coverage-consumer-persistence-rejected-goes-to-dlq" description="System API 400: DLQ with PERSISTENCE_REJECTED">
    <munit:behavior>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:then-return>
          <munit-tools:payload value="#[{}]"/>
          <munit-tools:attributes value="#[{statusCode: 400}]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <set-variable variableName="queuePublishFlow" value="coverage-publish-stub-flow"/>
      <choice><when expression="#[false]"><flow-ref name="coverage-publish-stub-flow"/></when></choice>
      <set-payload value="#[readUrl('classpath://test-data/envelope-valid.json', 'text/plain')]"/>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="order-consumer-processing-private-flow"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[vars.dlqReason]" is="#[MunitTools::equalTo('PERSISTENCE_REJECTED')]"/>
      <munit-tools:assert-that expression="#[vars.publishLog[0]]" is="#[MunitTools::equalTo('orders-dlq')]"/>
    </munit:validation>
  </munit:test>

